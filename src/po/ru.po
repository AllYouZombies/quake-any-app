#: src/extension.js:90 src/extension.js:103
msgid "Quake Any App"
msgstr "Quake Any App"

#: src/extension.js:91
#, javascript-format
msgid "Select an application for slot %s in preferences."
msgstr "Выберите приложение для слота %s в настройках."

#: src/extension.js:104
#, javascript-format
msgid "No application found with id %s. Skipping ..."
msgstr "Приложение с идентификатором %s не найдено. Пропускаю ..."

#: src/prefs.js:207
#, javascript-format
msgid "Slot %s"
msgstr "Слот %s"

#: src/prefs.js:213 src/prefs.js:224
msgid "Application"
msgstr "Приложение"

#: src/prefs.js:305
msgid "Launch Options"
msgstr "Аргументы запуска"

#: src/prefs.js:307
msgid "Optional command-line arguments. For example: -o font_size=18"
msgstr "Необязательные аргументы командной строки. Например: -o font_size=18"

#: src/prefs.js:367
msgid "General"
msgstr "Основные"

