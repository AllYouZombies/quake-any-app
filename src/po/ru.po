#: src/prefs.js:650
msgid "Left/Top"
msgstr "Слева/Сверху"

#: src/prefs.js:650
msgid "Right/Bottom"
msgstr "Справа/Снизу"

#: src/prefs.js:650
msgid "Center"
msgstr "По центру"

#: src/prefs.js:657
msgid "Alignment"
msgstr "Выравнивание"

#: src/prefs.js:658
msgid "Window alignment (horizontal for top/bottom, vertical for left/right)"
msgstr ""
"Выравнивание окна (горизонтальное для верхнего/нижнего края, вертикальное "
"для левого/правого)"

#: src/prefs.js:676
msgid "Always On Top"
msgstr "Поверх всех окон"

#: src/prefs.js:677
msgid "Window appears on top of all other non-topmost windows"
msgstr "Окно отображается поверх всех других обычных окон"

#: src/prefs.js:690
msgid "Hide In Certain Modes"
msgstr "Скрывать в особых режимах"

#: src/prefs.js:691
msgid "Window won't appear in overview mode or Alt+Tab"
msgstr "Окно не отображается в режиме обзора и при переключении Alt+Tab"

#: src/prefs.js:713
msgid "Global"
msgstr "Глобальные"

#: src/prefs.js:718
msgid "Display Settings"
msgstr "Настройки монитора"

#: src/prefs.js:723
msgid "Show on the current Display"
msgstr "Показывать на текущем мониторе"

#: src/prefs.js:724
msgid "Show on the Display that has the mouse pointer"
msgstr "Показывать на мониторе с курсором мыши"

#: src/prefs.js:737
msgid "Show on the primary Display"
msgstr "Показывать на основном мониторе"

#: src/prefs.js:738
msgid "Show on the Display set as Primary in GNOME Display settings"
msgstr "Показывать на мониторе, назначенном основным в настройках GNOME"

#: src/prefs.js:766
msgid "Display"
msgstr "Монитор"

#: src/prefs.js:767
msgid "Which display to render the application on"
msgstr "На каком мониторе отображать приложение"

#: src/prefs.js:819
msgid "Animation Time"
msgstr "Длительность анимации"

#: src/prefs.js:820
msgid "Duration of the dropdown animation in milliseconds"
msgstr "Продолжительность анимации выдвижения в миллисекундах"
