#: src/prefs.js:472
msgid "Position"
msgstr "Расположение"

#: src/prefs.js:481
msgid "Top"
msgstr "Сверху"

#: src/prefs.js:481
msgid "Bottom"
msgstr "Снизу"

#: src/prefs.js:481
msgid "Left"
msgstr "Слева"

#: src/prefs.js:481
msgid "Right"
msgstr "Справа"

