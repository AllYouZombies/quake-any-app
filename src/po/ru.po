#: src/prefs.js:375
msgid "Shortcut to activate this application"
msgstr "Сочетание клавиш для вызова приложения"

#: src/prefs.js:379
msgid "Select a shortcut"
msgstr "Выберите сочетание клавиш"

#: src/prefs.js:393
#, javascript-format
msgid "Enter new shortcut for Slot %s"
msgstr "Введите новое сочетание клавиш для слота %s"

#: src/prefs.js:406
msgid "Set Shortcut"
msgstr "Задать сочетание клавиш"

#: src/prefs.js:458
msgid "Auto Hide App"
msgstr "Автоскрытие"

#: src/prefs.js:459
msgid "Hide window when it loses focus"
