#: src/extension.js:90 src/extension.js:103
msgid "Quake Any App"
msgstr "Quake Any App"

#: src/extension.js:91
#, javascript-format
msgid "Select an application for slot %s in preferences."
msgstr "Ayarlardan %s. yuva için bir uygulama seçin."

#: src/extension.js:104
#, javascript-format
msgid "No application found with id %s. Skipping ..."
msgstr "%s kimliğine sahip uygulama bulunamadı. Atlanıyor ..."

#: src/prefs.js:207
#, javascript-format
msgid "Slot %s"
msgstr "Yuva %s"

#: src/prefs.js:213 src/prefs.js:224
msgid "Application"
msgstr "Uygulama"

#: src/prefs.js:305
msgid "Launch Options"
msgstr "Başlatma Seçenekleri"

#: src/prefs.js:307
msgid "Optional command-line arguments. For example: -o font_size=18"
msgstr "İsteğe bağlı komut satırı argümanları. Örneğin: -o font_size=18"

#: src/prefs.js:367
msgid "General"
msgstr "Genel"

#: src/prefs.js:374
msgid "Toggle Shortcut"
msgstr "Açma/Kapama Kısayolu"

#: src/prefs.js:375
msgid "Shortcut to activate this application"
msgstr "Bu uygulamayı etkinleştirmek için kısayol"

#: src/prefs.js:379
msgid "Select a shortcut"
msgstr "Kısayol seçin"

#: src/prefs.js:393
#, javascript-format
msgid "Enter new shortcut for Slot %s"
msgstr "%s. yuva için yeni kısayol girin"

#: src/prefs.js:406
msgid "Set Shortcut"
msgstr "Kısayol Ayarla"

#: src/prefs.js:458
msgid "Auto Hide App"
msgstr "Uygulamayı Otomatik Gizle"

#: src/prefs.js:459
msgid "Hide window when it loses focus"
msgstr "Odağını kaybettiğinde pencereyi gizle"

#: src/prefs.js:472
msgid "Position"
msgstr "Konum"

#: src/prefs.js:481
msgid "Top"
msgstr "Üst"

#: src/prefs.js:481
msgid "Bottom"
msgstr "Alt"

#: src/prefs.js:481
msgid "Left"
msgstr "Sol"

#: src/prefs.js:481
msgid "Right"
msgstr "Sağ"

#: src/prefs.js:491
msgid "Screen Edge"
msgstr "Ekran Kenarı"

#: src/prefs.js:492
msgid "Which edge the window should appear from"
msgstr "Pencerenin hangi kenardan görüneceği"

#: src/prefs.js:511
msgid "Vertical Size"
msgstr "Dikey Boyut"

#: src/prefs.js:512
msgid "Application vertical size"
msgstr "Uygulamanın dikey boyutu"

#: src/prefs.js:527 src/prefs.js:595
msgid "Percent"
msgstr "Yüzde"

#: src/prefs.js:527 src/prefs.js:595
msgid "Pixels"
msgstr "Piksel"

#: src/prefs.js:537
msgid "Vertical Size Unit"
msgstr "Dikey Boyut Birimi"

#: src/prefs.js:538
msgid "Unit for vertical size measurement"
msgstr "Dikey boyut ölçü birimi"

#: src/prefs.js:555
msgid "Application vertical size in pixels"
msgstr "Uygulamanın piksel cinsinden dikey boyutu"

#: src/prefs.js:558
msgid "Application vertical size in percent"
msgstr "Uygulamanın yüzde cinsinden dikey boyutu"

#: src/prefs.js:579
msgid "Horizontal Size"
msgstr "Yatay Boyut"

#: src/prefs.js:580
msgid "Application horizontal size"
msgstr "Uygulamanın yatay boyutu"

#: src/prefs.js:605
msgid "Horizontal Size Unit"
msgstr "Yatay Boyut Birimi"

#: src/prefs.js:606
msgid "Unit for horizontal size measurement"
msgstr "Yatay boyut ölçü birimi"

#: src/prefs.js:623
msgid "Application horizontal size in pixels"
msgstr "Uygulamanın piksel cinsinden yatay boyutu"

#: src/prefs.js:626
msgid "Application horizontal size in percent"
msgstr "Uygulamanın yüzde cinsinden yatay boyutu"

#: src/prefs.js:650
msgid "Left/Top"
msgstr "Sol/Üst"

#: src/prefs.js:650
msgid "Right/Bottom"
msgstr "Sağ/Alt"

#: src/prefs.js:650
msgid "Center"
msgstr "Merkez"

#: src/prefs.js:657
msgid "Alignment"
msgstr "Hizalama"

#: src/prefs.js:658
msgid "Window alignment (horizontal for top/bottom, vertical for left/right)"
msgstr "Pencere hizalaması (üst/alt için yatay, sol/sağ için dikey)"

#: src/prefs.js:676
msgid "Always On Top"
msgstr "Daima Üstte"

#: src/prefs.js:677
msgid "Window appears on top of all other non-topmost windows"
msgstr "Pencere, en üstte olmayan diğer tüm pencerelerin üzerinde görünür"

#: src/prefs.js:690
msgid "Hide In Certain Modes"
msgstr "Belirli Modlarda Gizle"

#: src/prefs.js:691
msgid "Window won't appear in overview mode or Alt+Tab"
msgstr "Pencere genel görünümde veya Alt+Tab içinde görünmez"

#: src/prefs.js:713
msgid "Global"
msgstr "Global"

#: src/prefs.js:718
msgid "Display Settings"
msgstr "Ekran Ayarları"

#: src/prefs.js:723
msgid "Show on the current Display"
msgstr "Mevcut Ekranda Göster"

#: src/prefs.js:724
msgid "Show on the Display that has the mouse pointer"
msgstr "Fare imlecinin bulunduğu ekranda göster"

#: src/prefs.js:737
msgid "Show on the primary Display"
msgstr "Birincil ekranda göster"

#: src/prefs.js:738
msgid "Show on the Display set as Primary in GNOME Display settings"
msgstr "GNOME Ekran ayarlarında Birincil olarak ayarlanan ekranda göster"

#: src/prefs.js:766
msgid "Display"
msgstr "Ekran"

#: src/prefs.js:767
msgid "Which display to render the application on"
msgstr "Uygulamanın hangi ekranda gösterileceği"

#: src/prefs.js:819
msgid "Animation Time"
msgstr "Animasyon Süresi"

#: src/prefs.js:820
msgid "Duration of the dropdown animation in milliseconds"
msgstr "Yukarıdan inmenin milisaniye cinsinden süresi"

